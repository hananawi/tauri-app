{
  "manifest_version": 3,
  "name": "橘子划词问 AI",
  "version": "0.1.0",
  "description": "选中网页文字，旁边浮现「问 AI」，在页内浮层流式展示回答并支持追问。",
  "permissions": ["storage"],
  "optional_host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "options_page": "options.html",
  "action": {
    "default_title": "划词问 AI 设置"
  },
  "icons": {
    "16": "icons/16.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  }
}
